DATABASE_URL=CHANGEME_DATABASE_URL
AUTH_SECRET=CHANGEME_AUTH_SECRET
ADMIN_EMAIL=admin@example.com
# Run: npx tsx scripts/hash-password.ts <your-password>
ADMIN_PASSWORD_HASH=CHANGEME_ADMIN_PASSWORD_HASH
APP_BASE_URL=http://localhost:3000
APP_DISPLAY_NAME="Weekly Client Reports"

# Trigger.dev
TRIGGER_SECRET_KEY=CHANGEME_TRIGGER_SECRET_KEY
TRIGGER_PROJECT_REF=CHANGEME_TRIGGER_PROJECT_REF

# GitHub API token with access to the repositories you report on
GITHUB_PAT=CHANGEME_GITHUB_PAT

# App-level encryption key for secrets stored at rest. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# OpenRouter
OPENROUTER_API_KEY=CHANGEME_OPENROUTER_API_KEY
# Optional per-call-site model overrides. Defaults (used if unset) are baked
# into the code: narrative=deepseek/deepseek-v4-pro, email+revise=deepseek/deepseek-v4-flash.
OPENROUTER_MODEL_NARRATIVE=deepseek/deepseek-v4-pro
OPENROUTER_MODEL_EMAIL=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_REVISION=deepseek/deepseek-v4-flash

# Vercel Blob
WEEKLY_CLIENT_REPORTS_BLOB_READ_WRITE_TOKEN=CHANGEME_BLOB_READ_WRITE_TOKEN

# Report prompt. Use NARRATIVE_PROMPT_BASE64 for Vercel/Trigger secrets.
NARRATIVE_PROMPT=
NARRATIVE_PROMPT_BASE64=
NARRATIVE_PROMPT_PATH=
REPORT_SENDER_NAME=Your Name

# Email workflow webhook
N8N_WEBHOOK_URL=CHANGEME_WEBHOOK_URL
N8N_WEBHOOK_SECRET=CHANGEME_WEBHOOK_SECRET

# Telegram bot
TELEGRAM_BOT_TOKEN=CHANGEME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGEME_TELEGRAM_CHAT_ID

# Optional seed input
SEED_CLIENTS_PATH=

# Reminder: hours a report must be in 'drafted' status before a nudge is sent (default: 18)
REMINDER_THRESHOLD_HOURS=18

# Sentry — observability (errors and performance)
# SENTRY_DSN is for server/edge; NEXT_PUBLIC_SENTRY_DSN is for the browser bundle
SENTRY_DSN=CHANGEME_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=CHANGEME_SENTRY_DSN
SENTRY_ORG=CHANGEME_SENTRY_ORG
SENTRY_PROJECT=CHANGEME_SENTRY_PROJECT
SENTRY_AUTH_TOKEN=CHANGEME_SENTRY_AUTH_TOKEN
